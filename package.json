{
  "name": "robotics-training-sim",
  "private": true,
  "version": "0.1.0",
  "description": "Browser-based robotics training simulator for students, built on MuJoCo physics with Unitree G1 and Go2 robot models.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "license": "BSD-3-Clause",
  "dependencies": {
    "@mujoco/mujoco": "3.14.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
